
fn main() {
    
    test_to_number()
    test_append()
    test_string_addition()

}

fn test_to_number() {
    let x = "1"
    print(to_number(x) + 2, ', should print: 3')
    // tests number by addition
}

fn test_append() {
    let mut x = []
    let y = "a"
    let z = 1
    x.append(y)
    x.append(z)
    print(x, ', should print: ["a", 1]')
}

fn test_string_addition() {
    let y = "hello"
    let x = " world"
    print(y+x, ', should print: "hello world"')
}
